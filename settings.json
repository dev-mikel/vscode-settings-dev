{
  "search.exclude": {
    "**/node_modules": true,
    "**/.venv": true,
    "**/dist": true,
    "**/build": true,
    "**/.next": true,
    "**/.nuxt": true,
    "**/coverage": true
  },
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/.pytest_cache": true,
    "**/__pycache__": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.venv/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/__pycache__/**": true,
    "**/.pytest_cache/**": true,
    "**/.next/**": true,
    "**/.nuxt/**": true,
    "**/coverage/**": true
  },
  "files.autoSave": "off",
  "files.associations": {
    "*.omp.json": "json"
  },
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.inlineSuggest.enabled": true,
  "editor.scrollBeyondLastLine": false,
  "editor.smoothScrolling": true,
  "editor.cursorBlinking": "smooth",
  "editor.cursorStyle": "line",
  "editor.cursorWidth": 2,
  "editor.fontFamily": "FiraCode Nerd Font",
  "editor.fontSize": 14,
  "editor.lineHeight": 1.5,
  "editor.fontLigatures": true,
  "editor.lineNumbers": "on",
  "editor.formatOnSave": false,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.acceptSuggestionOnEnter": "off",
  "editor.snippetSuggestions": "bottom",
  "editor.codeLens": false,
  "editor.codeLensFontSize": 8,
  "editor.mouseWheelZoom": true,
  "editor.hover.delay": 500,
  "editor.hover.above": false,
  "editor.renderLineHighlight": "all",
  "editor.renderLineHighlightOnlyWhenFocus": false,
  "editor.matchBrackets": "never",
  "editor.bracketPairColorization.enabled": true,
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.guides.bracketPairs": "active",
  "editor.guides.bracketPairsHorizontal": false,
  "editor.guides.indentation": false,
  "editor.guides.highlightActiveBracketPair": true,
  "editor.guides.highlightActiveIndentation": true,
  "editor.stickyScroll.enabled": true,
  "editor.stickyScroll.maxLineCount": 3,
  "editor.minimap.enabled": false,
  "editor.minimap.scale": 3,
  "editor.minimap.side": "right",
  "editor.minimap.maxColumn": 60,
  "editor.minimap.showSlider": "always",
  "editor.minimap.showMarkSectionHeaders": true,
  "editor.minimap.showRegionSectionHeaders": true,
  "editor.minimap.sectionHeaderFontSize": 10,
  "editor.minimap.sectionHeaderLetterSpacing": 2,
  "editor.minimap.markSectionHeaderRegex": "\\bMARK:\\s*(?<separator>-?)\\s*(?<label>[^*}]+)",
  "editor.wordWrap": "off",
  "editor.wrappingIndent": "same",
  "editor.experimental.treeSitterTelemetry": false,
  "terminal.integrated.enablePersistentSessions": true,
  "terminal.integrated.persistentSessionReviveProcess": "onExit",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.fontFamily": "FiraMono Nerd Font Mono",
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorWidth": 2,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.mouseWheelZoom": false,
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.allowChords": false,
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "terminal.integrated.enableVisualBell": true,
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.shellIntegration.environmentReporting": true,
  "terminal.integrated.mouseWheelScrollSensitivity": 3,
  "terminal.integrated.profiles.linux": {
    "zsh": {
      "path": "/usr/bin/zsh",
      "args": ["-l"]
    }
  },
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.external.linuxExec": "xfce4-terminal",
  "workbench.editor.enablePreview": true,
  "workbench.editor.enablePreviewFromQuickOpen": false,
  "workbench.iconTheme": "material-icon-theme",
  "workbench.preferredDarkColorTheme": "GitHub Dark Default",
  "workbench.colorTheme": "GitHub Dark Default",
  "workbench.startupEditor": "terminal",
  "workbench.tree.indent": 16,
  "workbench.tree.renderIndentGuides": "always",
  "workbench.view.alwaysShowHeaderActions": true,
  "workbench.view.showQuietly": {
    "workbench.panel.output": true
  },
  "workbench.enableExperiments": false,
  "workbench.settings.enableNaturalLanguageSearch": false,
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "window.commandCenter": false,
  "window.menuBarVisibility": "compact",
  "window.title": "${activeFolderLong}",
  "explorer.confirmDelete": true,
  "explorer.confirmDragAndDrop": true,
  "explorer.decorations.enabled": true,
  "explorer.decorations.colors": true,
  "explorer.decorations.badges": true,
  "diffEditor.experimental.showMoves": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.maxComputationTime": 30000,
  "diffEditor.maxFileSize": 0,
  "diffEditor.hideUnchangedRegions.enabled": true,
  "diffEditor.renderSideBySide": true,
  "diffEditor.wordWrap": "off",
  "git.optimisticUpdate": false,
  "git.openRepositoryInParentFolders": "always",
  "git.suggestSmartCommit": false,
  "git.autofetch": true,
  "git.enableSmartCommit": false,
  "git.confirmSync": false,
  "git.decorations.enabled": true,
  "extensions.autoUpdate": false,
  "extensions.autoCheckUpdates": false,
  "extensions.ignoreRecommendations": true,
  "telemetry.telemetryLevel": "off",
  "telemetry.feedback.enabled": false,
  "telemetry.editStats.enabled": false,
  "python.terminal.activateEnvInCurrentTerminal": true,
  "python.terminal.useEnvFile": true,
  "security.workspace.trust.startupPrompt": "never",
  "security.workspace.trust.banner": "never",
  "security.workspace.trust.enabled": false,
  "colorize.colorized_variables": ["CSS"],
  "colorize.languages": ["javascript", "html", "css", "json"],
  "colorize.include": ["*.css", "*.scss", "*.sass", "*.less", "*.vue", "*.js", "*.ts", "*.jsx", "*.tsx", "*.json"],
  "markdownlint.config": {
    "MD013": false,
    "MD024": false,
    "MD025": false,
    "MD026": false,
    "MD031": false,
    "MD032": false,
    "MD033": false,
    "MD034": false,
    "MD036": false,
    "MD040": false,
    "MD041": false,
    "MD052": false,
    "MD003": {
      "style": "atx"
    },
    "MD004": {
      "style": "dash"
    },
    "MD007": {
      "indent": 2
    },
    "MD029": {
      "style": "one_or_ordered"
    },
    "MD030": {
      "ul_single": 1,
      "ol_single": 1,
      "ul_multi": 1,
      "ol_multi": 1
    },
    "MD046": {
      "style": "fenced"
    },
    "MD048": {
      "style": "consistent"
    },
    "MD049": {
      "style": "asterisk"
    },
    "MD050": {
      "style": "asterisk"
    },
    "MD060": false
  },
  "markdownlint.run": "onSave",
  "markdownlint.focusMode": 2,
  "markdownlint.lintWorkspaceGlobs": ["**/*.md", "!node_modules", "!.git", "!dist", "!build"],
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off"
    },
    "editor.inlineSuggest.enabled": false,
    "editor.formatOnSave": false
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.detectIndentation": false,
    "prettier.tabWidth": 2,
    "prettier.useTabs": false,
    "prettier.printWidth": 120,
    "prettier.trailingComma": "none",
    "prettier.bracketSpacing": false,
    "prettier.quoteProps": "consistent",
    "prettier.arrowParens": "always",
    "prettier.singleQuote": false,
    "prettier.jsxSingleQuote": false,
    "prettier.semi": true,
    "prettier.bracketSameLine": true,
    "prettier.proseWrap": "preserve"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.detectIndentation": false,
    "prettier.tabWidth": 2,
    "prettier.useTabs": false,
    "prettier.printWidth": 120,
    "prettier.trailingComma": "none",
    "prettier.bracketSpacing": false,
    "prettier.quoteProps": "consistent",
    "prettier.arrowParens": "always",
    "prettier.singleQuote": false,
    "prettier.jsxSingleQuote": false,
    "prettier.semi": true,
    "prettier.bracketSameLine": true,
    "prettier.proseWrap": "preserve"
  },
  "workbench.colorCustomizations": {
    "foreground": "#cdcdcd",
    "editor.background": "#13161a",
    "editor.foreground": "#cdcdcd",
    "editor.lineHighlightBackground": "#2c3034",
    "editorGutter.background": "#13161a",
    "editorBracketHighlight.foreground1": "#106ae1",
    "editorBracketHighlight.foreground2": "#49b854",
    "editorBracketHighlight.foreground3": "#ff8c00",
    "editorBracketHighlight.foreground4": "#96e600",
    "editorBracketHighlight.foreground5": "#24b0f6",
    "editorBracketHighlight.foreground6": "#f7473b",
    "editorBracketHighlight.unexpectedBracket.foreground": "#adb8c5",
    "minimap.background": "#13161a",
    "minimapSlider.background": "#1c439151",
    "minimapSlider.hoverBackground": "#1c43919e",
    "minimapSlider.activeBackground": "#1c439151",
    "scrollbarSlider.background": "#636979",
    "scrollbarSlider.hoverBackground": "#9195a2",
    "scrollbarSlider.activeBackground": "#636979",
    "scrollbar.shadow": "#444853",
    "editorOverviewRuler.background": "#2c3034",
    "editorOverviewRuler.border": "#2e333a",
    "focusBorder": "#0c5dff",
    "tab.border": "#070a0f",
    "tab.activeBackground": "#13161a",
    "tab.activeBorder": "#333538",
    "tab.activeBorderTop": "#0c5dff",
    "tab.activeForeground": "#dddddd",
    "tab.inactiveBackground": "#333538",
    "tab.inactiveForeground": "#dddddd",
    "tab.unfocusedActiveBackground": "#13161a",
    "tab.unfocusedActiveBorder": "#333538",
    "tab.unfocusedActiveBorderTop": "#0c5dff",
    "sideBar.background": "#13161a",
    "sideBar.foreground": "#dddddd",
    "sideBarTitle.background": "#13161a",
    "sideBarSectionHeader.background": "#070a0f",
    "sideBarSectionHeader.foreground": "#cdcdcd",
    "activityBar.background": "#070a0f",
    "activityBar.foreground": "#dddddd",
    "activityBar.activeBackground": "#13161a",
    "activityBar.activeBorder": "#5dbbff",
    "activityBar.inactiveForeground": "#cdcdcd",
    "activityBarBadge.background": "#0e59ba",
    "activityBarBadge.foreground": "#dddddd",
    "statusBar.background": "#070a0f",
    "statusBar.foreground": "#eeeeee",
    "statusBarItem.remoteBackground": "#070a0f",
    "statusBarItem.remoteForeground": "#eeeeee",
    "panel.background": "#070a0f",
    "panelTitle.activeBorder": "#0c5dff",
    "titleBar.activeBackground": "#13161a",
    "titleBar.inactiveBackground": "#1e2329",
    "titleBar.activeForeground": "#eeeeee",
    "titleBar.inactiveForeground": "#eeeeee",
    "button.background": "#0d50a8",
    "button.hoverBackground": "#0e59ba",
    "button.foreground": "#eeeeee",
    "badge.background": "#0e59ba",
    "badge.foreground": "#ffffff",
    "terminal.background": "#13161a",
    "terminal.foreground": "#cdcdcd",
    "tree.indentGuidesStroke": "#0099ff",
    "tree.inactiveIndentGuidesStroke": "#adb8c5",
    "breadcrumb.foreground": "#dddddd",
    "dropdown.foreground": "#cdcdcd",
    "icon.foreground": "#dddddd",
    "settings.headerForeground": "#dddddd",
    "list.inactiveSelectionBackground": "#2a3036",
    "list.inactiveSelectionForeground": "#dddddd"
  }
}
